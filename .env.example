# Copie para .env e preencha somente o que for usar. Nunca versione o .env.

# --- Servidor ---
CIOS_HOST=127.0.0.1
CIOS_PORT=8000

# --- Pesquisa ---
# Política de User-Agent da Wikimedia (https://w.wiki/4wJS): "<cliente>/<versão> (<contato>) <biblioteca>/<versão>".
# Substitua o contato por um e-mail ou URL seu; sem contato a API pode responder 403.
WIKIMEDIA_USER_AGENT=CreatorIntelligenceOS/0.1 (contato: seu-email@exemplo.com) httpx/0.28
# Opcional: chave da YouTube Data API v3 (Google Cloud Console). Sem ela, concorrência = hipótese.
YOUTUBE_API_KEY=

# --- Filmagens reais (Visual Hunter) ---
# Wikimedia Commons funciona sem chave. Chaves gratuitas ampliam muito o acervo (ex.: polvo liberando tinta):
# Pexels: https://www.pexels.com/api/  ·  Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Conteúdo ---
# template (local) | llm (não implementado no MVP)
SCRIPT_PROVIDER=template
# ChatGPT (modo híbrido): revisão de roteiro, storytelling e copywriting. Gera custo na sua conta OpenAI.
OPENAI_API_KEY=
# Nome exato do modelo disponível na sua conta (ex.: o que aparece em platform.openai.com)
OPENAI_MODEL=
# Opcional: preço por 1 milhão de tokens (USD) para estimar custo no painel
OPENAI_PRICE_IN_PER_1M=
OPENAI_PRICE_OUT_PER_1M=

# --- Produção ---
# Deixe vazio para usar ffmpeg do PATH ou o binário do imageio-ffmpeg
FFMPEG_PATH=
# speechify (API paga, voz escolhida por você) | winrt (Windows, local, padrão) | sapi | silent
TTS_PROVIDER=
# Voz do Windows (gratuita): "Microsoft Maria" (feminina, padrão) ou "Microsoft Daniel" (masculina)
TTS_VOICE_PT_WINRT=Microsoft Maria
# Speechify: chave da API e ID da voz escolhida (ex.: feminina carioca). Gera custo na sua conta Speechify.
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=
TTS_VOICE_PT=Microsoft Maria Desktop
TTS_VOICE_EN=Microsoft Zira Desktop

# --- Publicação (desativada no MVP; exigirá OAuth oficial) ---
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
