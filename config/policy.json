{
  "_doc": "Política de autonomia. Somente leitura em tempo de execução: nenhum agente pode alterá-la. Edite manualmente e reinicie o servidor.",
  "auto_allowed": [
    "public_research",
    "organize_project_files",
    "generate_scripts",
    "generate_captions",
    "local_render",
    "run_tests",
    "update_reports",
    "limited_retry"
  ],
  "requires_human_approval": [
    "publish_video",
    "make_content_public",
    "spend_money",
    "create_external_account",
    "change_credentials_or_permissions",
    "send_private_data",
    "delete_outside_workdirs",
    "destructive_command",
    "accept_terms"
  ],
  "allowed_subprocesses": ["ffmpeg", "powershell-sapi-tts"],
  "allowed_write_dirs": ["data", "output", "imagens"],
  "limits": {
    "task_timeout_s": 1800,
    "max_retries": 1,
    "max_concurrency": 2,
    "max_tasks_per_run": 30,
    "max_file_size_mb": 500,
    "max_api_calls_per_run": 300,
    "max_cost_usd_per_run": 0.5,
    "max_render_seconds": 900,
    "max_video_duration_s": 900,
    "max_short_duration_s": 60
  }
}
